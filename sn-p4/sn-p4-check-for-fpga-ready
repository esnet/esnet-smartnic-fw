#!/usr/bin/env -S regio-esnet-smartnic script

import sys

#---------------------------------------------------------------------------------------------------
def stdout(msg):
    sys.stdout.write(msg)

#---------------------------------------------------------------------------------------------------
def main():
    stdout('Checking for FPGA readiness ... ')

    if hasattr(dev0.bar2, 'syscfg'):
        stdout('Checking syscfg DNA registers ... ')
        for dna in dev0.bar2.syscfg.dna:
            if dna._r == 0xffffffff:
                stdout('FPGA not ready.\n')
                sys.exit(1)
    elif hasattr(dev0.bar2, 'shell_cfg'):
        stdout('Checking shell_cfg ID register ... ')
        if dev0.bar2.shell_cfg.id == 0xffffffff:
            stdout('FPGA not ready.\n')
            sys.exit(1)
    else:
        stdout('Unknown regmap ... FPGA not ready.\n')
        sys.exit(1)

    stdout('FPGA ready.\n')
    sys.exit(0)

#---------------------------------------------------------------------------------------------------
if __name__ == '__main__':
    main()
